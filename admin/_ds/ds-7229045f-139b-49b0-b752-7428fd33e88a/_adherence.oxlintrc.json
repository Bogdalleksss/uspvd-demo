{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/AccountCard/**",
              "components/BarChart/**",
              "components/Button/**",
              "components/Dialog/**",
              "components/ListRow/**",
              "components/NotificationCard/**",
              "components/OTPField/**",
              "components/ReadingInput/**",
              "components/StatusBanner/**",
              "components/TabBar/**",
              "components/TextField/**",
              "components/TopBar/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:address|accountNumber|amount|noDebt|readingsStatus|readingsDeadline|key|ref|className|style|children)$/]",
        "message": "<AccountCard> doesn't accept that prop. Declared props: address, accountNumber, amount, noDebt, readingsStatus, readingsDeadline."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountCard'] > JSXAttribute[name.name='readingsStatus'] > Literal[value!=/^(?:missing|submitted)$/]",
        "message": "<AccountCard> readingsStatus must be one of 'missing' | 'submitted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChartDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:month|value|key|ref|className|style|children)$/]",
        "message": "<BarChartDatum> doesn't accept that prop. Declared props: month, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|state|icon|children|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, state, icon, children, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|pressed|disabled|loading)$/]",
        "message": "<Button> state must be one of 'default' | 'pressed' | 'disabled' | 'loading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|confirmLabel|cancelLabel|danger|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, text, confirmLabel, cancelLabel, danger, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|trailing|danger|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, title, subtitle, trailing, danger, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='trailing'] > Literal[value!=/^(?:none|chevron|switch|switch-off)$/]",
        "message": "<ListRow> trailing must be one of 'none' | 'chevron' | 'switch' | 'switch-off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|text|date|read|key|ref|className|style|children)$/]",
        "message": "<NotificationCard> doesn't accept that prop. Declared props: type, title, text, date, read."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:outage|reminder|done)$/]",
        "message": "<NotificationCard> type must be one of 'outage' | 'reminder' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OTPField'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|digits|focusIndex|seconds|onChangeNumber|key|ref|className|style|children)$/]",
        "message": "<OTPField> doesn't accept that prop. Declared props: phone, digits, focusIndex, seconds, onChangeNumber."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadingInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:meterName|meterNumber|prevReading|prevDate|value|unit|usage|error|warning|hint|key|ref|className|style|children)$/]",
        "message": "<ReadingInput> doesn't accept that prop. Declared props: meterName, meterNumber, prevReading, prevDate, value, unit, usage, error, warning, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|text|action|onAction|key|ref|className|style|children)$/]",
        "message": "<StatusBanner> doesn't accept that prop. Declared props: tone, title, text, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<StatusBanner> tone must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|readings|payments|more)$/]",
        "message": "<TabBar> active must be one of 'home' | 'readings' | 'payments' | 'more'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hint|error|state|inputMode|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, hint, error, state, inputMode."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus|error)$/]",
        "message": "<TextField> state must be one of 'default' | 'focus' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='inputMode'] > Literal[value!=/^(?:text|tel|numeric)$/]",
        "message": "<TextField> inputMode must be one of 'text' | 'tel' | 'numeric'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|showBack|onBack|action|hasUnread|onAction|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, showBack, onBack, action, hasUnread, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute[name.name='action'] > Literal[value!=/^(?:none|notifications)$/]",
        "message": "<TopBar> action must be one of 'none' | 'notifications'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AccountCard": {
        "replaces": []
      },
      "BarChartDatum": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "Dialog": {
        "replaces": []
      },
      "ListRow": {
        "replaces": []
      },
      "NotificationCard": {
        "replaces": []
      },
      "OTPField": {
        "replaces": []
      },
      "ReadingInput": {
        "replaces": []
      },
      "StatusBanner": {
        "replaces": []
      },
      "TabBar": {
        "replaces": []
      },
      "TextField": {
        "replaces": []
      },
      "TopBar": {
        "replaces": []
      }
    },
    "tokens": [
      "--bg",
      "--border-input",
      "--brand-blue",
      "--brand-blue-active",
      "--brand-gradient-end",
      "--brand-red",
      "--divider",
      "--error",
      "--error-soft",
      "--font-sans",
      "--on-primary",
      "--primary",
      "--primary-pressed",
      "--primary-soft",
      "--radius-full",
      "--radius-lg",
      "--radius-md",
      "--radius-sm",
      "--scrim",
      "--shadow-card",
      "--shadow-sheet",
      "--size-control",
      "--size-icon",
      "--size-screen",
      "--size-tabbar",
      "--size-touch-min",
      "--space-1",
      "--space-12",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-8",
      "--success",
      "--success-soft",
      "--success-text",
      "--surface",
      "--text-primary",
      "--text-secondary",
      "--warning-soft",
      "--warning-text"
    ],
    "tokenKinds": {
      "--primary": "color",
      "--primary-pressed": "color",
      "--on-primary": "color",
      "--primary-soft": "color",
      "--brand-blue": "color",
      "--brand-blue-active": "color",
      "--brand-gradient-end": "color",
      "--brand-red": "color",
      "--text-primary": "font",
      "--text-secondary": "font",
      "--border-input": "color",
      "--divider": "color",
      "--bg": "color",
      "--surface": "color",
      "--scrim": "color",
      "--error": "color",
      "--error-soft": "color",
      "--success": "color",
      "--success-text": "font",
      "--success-soft": "color",
      "--warning-text": "font",
      "--warning-soft": "color",
      "--font-sans": "font",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
      "--space-6": "spacing",
      "--space-8": "spacing",
      "--space-12": "spacing",
      "--radius-sm": "radius",
